<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mbunayExamen.Views.Registro"
             Title="Registro">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label
                x:Name="UsuarioLabel"
                HorizontalOptions="Fill" />

            <Label
                Text="REGISTRO"
                TextColor="Blue"
                FontSize="22"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Fill" />

            <Grid
                ColumnDefinitions="*,*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">
                <Label Text="Nombre" Grid.Row="0" Grid.Column="0" />
                <Label Text="Apellido" Grid.Row="0" Grid.Column="1" />
                <Label Text="Edad" Grid.Row="0" Grid.Column="2" />

                <Entry
                    x:Name="NombreEntry"
                    Grid.Row="1"
                    Grid.Column="0"
                    Placeholder="Ingresar Nombre" />
                <Entry
                    x:Name="ApellidoEntry"
                    Grid.Row="1"
                    Grid.Column="1"
                    Placeholder="Ingresar Apellido" />
                <Entry
                    x:Name="EdadEntry"
                    Grid.Row="1"
                    Grid.Column="2"
                    Placeholder="Ingresar Edad"
                    Keyboard="Numeric"
                    TextChanged="OnEdadChanged" />
            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">
                <Label
                    Text="Fecha de inicio"
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalOptions="Center" />
                <DatePicker
                    x:Name="FechaPicker"
                    Grid.Row="0"
                    Grid.Column="1" />

                <Label
                    Text="Plan"
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalOptions="Center" />
                <Picker
                    x:Name="PlanPicker"
                    Grid.Row="1"
                    Grid.Column="1"
                    Title="Seleccione un plan">
                    <Picker.Items>
                        <x:String>Musculación</x:String>
                        <x:String>Cardio</x:String>
                        <x:String>Crossfit</x:String>
                        <x:String>Full</x:String>
                    </Picker.Items>
                </Picker>

                <Label
                    Text="Casillero"
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalOptions="Center" />
                <Switch
                    x:Name="CasilleroSwitch"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalOptions="Start"
                    Toggled="OnCasilleroToggled" />

                <Label
                    Text="Monto Inicial"
                    Grid.Row="3"
                    Grid.Column="0"
                    VerticalOptions="Center" />
                <Entry
                    x:Name="MontoEntry"
                    Grid.Row="3"
                    Grid.Column="1"
                    Keyboard="Numeric"
                    Placeholder="120 a 600"
                    TextChanged="OnMontoChanged" />

                <Button
                    Text="Calcular Pago mensual"
                    Grid.Row="4"
                    Grid.Column="0"
                    Clicked="OnCalcularClicked" />
                <Entry
                    x:Name="PagoEntry"
                    Grid.Row="4"
                    Grid.Column="1"
                    Placeholder="Pago mensual"
                    IsReadOnly="True" />
            </Grid>

            <Button
                Text="Ver Resumen"
                Clicked="OnVerResumenClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
