<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mbunayExamen.Views.Resumen"
             Title="Resumen">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label
                x:Name="UsuarioLabel"
                HorizontalOptions="Fill" />

            <Label
                Text="RESUMEN"
                FontSize="22"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Fill" />

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">
                <Label Text="Nombre" Grid.Row="0" Grid.Column="0" />
                <Label x:Name="NombreValor" Grid.Row="0" Grid.Column="1" />

                <Label Text="Apellido" Grid.Row="1" Grid.Column="0" />
                <Label x:Name="ApellidoValor" Grid.Row="1" Grid.Column="1" />

                <Label Text="Edad" Grid.Row="2" Grid.Column="0" />
                <Label x:Name="EdadValor" Grid.Row="2" Grid.Column="1" />

                <Label Text="Fecha de inicio" Grid.Row="3" Grid.Column="0" />
                <Label x:Name="FechaValor" Grid.Row="3" Grid.Column="1" />

                <Label Text="Plan" Grid.Row="4" Grid.Column="0" />
                <Label x:Name="PlanValor" Grid.Row="4" Grid.Column="1" />

                <Label Text="Casillero" Grid.Row="5" Grid.Column="0" />
                <Label x:Name="CasilleroValor" Grid.Row="5" Grid.Column="1" />

                <Label Text="Monto Inicial" Grid.Row="6" Grid.Column="0" />
                <Label x:Name="MontoValor" Grid.Row="6" Grid.Column="1" />

                <Label Text="Pago mensual" Grid.Row="7" Grid.Column="0" />
                <Label x:Name="PagoMensualValor" Grid.Row="7" Grid.Column="1" />

                <Label Text="Pago Total" Grid.Row="8" Grid.Column="0" />
                <Label x:Name="PagoTotalValor" Grid.Row="8" Grid.Column="1" />
            </Grid>

            <Button
                Text="Nuevo registro"
                Clicked="OnNuevoRegistroClicked" />
            <Button
                Text="Cerrar sesión"
                Clicked="OnCerrarSesionClicked" />
            <Button
                Text="Migrar TXT"
                Clicked="OnMigrarTxtClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
